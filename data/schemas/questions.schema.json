{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-foundation:schemas:questions",
  "title": "Pack demo questions (questions.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "examples": {
      "description": "The composer's example picker: these questions, in this order. Every featured question is among them, and together they declare every tool the pack's questions declare. Without it, the picker offers the featured questions, then the others, up to 12.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "tag",
          "question",
          "sources",
          "tools"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "tag": {
            "description": "The kind of question: DOCUMENTS (retrieval), SQL (tables), HYBRID (documents and tables), PREDICTION (Kumo), ONTOLOGY (Auto Ontology).",
            "enum": [
              "DOCUMENTS",
              "SQL",
              "HYBRID",
              "PREDICTION",
              "ONTOLOGY"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Pack-local source ids (pack.yaml sources[].id); the catalog prefixes them with the pack id."
          },
          "tools": {
            "description": "The tools the question is expected to use, as pills (Pill in contracts/tool-registry.schema.json). A recorded answer must use every one.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "retrieval",
                "duckdb",
                "kumo",
                "ontology"
              ]
            }
          },
          "featured": {
            "description": "Shown on the landing page and README quickstart; part of the replay recording set.",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "conversations": {
      "description": "Multi-turn conversations, each recorded as one replay session (demo.sh record --all): every turn is asked in the same conversation, after the answer to the turn before it.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "tag",
          "sources",
          "turns"
        ],
        "properties": {
          "id": {
            "description": "Unique among the pack's questions and conversations.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "tag": {
            "enum": [
              "DOCUMENTS",
              "SQL",
              "HYBRID",
              "PREDICTION",
              "ONTOLOGY"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "sources": {
            "description": "The sources every turn uses.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "turns": {
            "description": "The questions in order; a later turn may refer to an earlier answer.",
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-foundation:schemas:pack",
  "title": "Industry pack (data/packs/<id>/pack.yaml)",
  "description": "An industry pack: committed files plus the metadata the ingest service needs to load them into the knowledge catalog as <id>.<source> sources. Every file goes through the same pipeline as an upload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "description", "icon", "as_of", "disclaimer", "licenses", "provenance", "sources", "questions"],
  "properties": {
    "schema_version": { "const": "3" },
    "id": { "description": "The directory name.", "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "description": "The industry's name in the selector.", "type": "string", "minLength": 1, "maxLength": 40 },
    "description": { "type": "string", "minLength": 1, "maxLength": 600 },
    "icon": { "description": "An icon name from ui/src/adapters/ui/icons.tsx.", "type": "string", "maxLength": 64 },
    "as_of": { "description": "The date the fictional data is current to (YYYY-MM-DD).", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "disclaimer": { "type": "string", "minLength": 1, "maxLength": 600 },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "redistribution"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "redistribution": { "enum": ["allowed", "restricted", "unknown"] },
          "notes": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "synthetic", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string" },
          "kind": { "enum": ["generated", "download", "committed"] },
          "synthetic": { "type": "boolean" },
          "license": { "type": "string" },
          "as_of": { "type": "string" },
          "url": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/Source" }
    },
    "questions": { "description": "The questions file, relative to the pack.", "const": "questions.yaml" }
  },
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "agent_description", "kind", "files", "capabilities", "synthetic"],
      "properties": {
        "id": { "description": "Unique in the pack; the catalog id is <pack>.<id>.", "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "agent_description": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "kind": { "enum": ["documents", "structured"] },
        "files": {
          "description": "Glob patterns relative to the pack directory. Documents: pdf, png, jpg, tiff, webp, docx, pptx, html, md, txt. Structured: csv, tsv, xlsx, parquet, json, jsonl.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^files/" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unstructured_retrieval", "structured_retrieval", "structured_prediction"] }
        },
        "synthetic": { "type": "boolean" },
        "default_enabled": { "type": "boolean", "default": true },
        "example_questions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 300 } },
        "tables": {
          "description": "Structured sources: declarations that override profiling, by table name (the snake-cased file stem, or <stem>_<sheet> for a workbook with several sheets).",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/TableDeclaration" }
        },
        "prediction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["templates"],
          "properties": {
            "templates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "description", "pql"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "name": { "type": "string", "maxLength": 80 },
                  "description": { "type": "string", "maxLength": 400 },
                  "pql": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "anchor_time": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "documents" } } },
          "then": {
            "properties": { "capabilities": { "items": { "const": "unstructured_retrieval" } } },
            "not": { "anyOf": [{ "required": ["tables"] }, { "required": ["prediction"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "structured" } } },
          "then": { "properties": { "capabilities": { "items": { "enum": ["structured_retrieval", "structured_prediction"] } } } }
        }
      ]
    },
    "TableDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 600 },
        "primary_key": { "type": "string" },
        "time_column": { "type": "string" },
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column", "references"],
            "properties": {
              "column": { "type": "string" },
              "references": { "description": "<table>.<column>", "type": "string", "pattern": "^[a-z_][a-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$" }
            }
          }
        },
        "columns": {
          "description": "Column descriptions by column name.",
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}

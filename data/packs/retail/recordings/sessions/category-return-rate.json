          "content": {
            "query": "Return rate by product category in Q3 2026 (July 1 - Sept 30, 2026)",
            "databaseName": "retail_sales",
            "answer": null,
            "sql": "WITH\n  -- Net sales per category in Q3 2026\n  sales_q3 AS (\n    SELECT\n      p.category,\n      SUM(oi.line_amount) AS net_sales\n    FROM retail_sales.orders AS o\n    JOIN retail_sales.order_items AS oi ON oi.order_id = o.order_id\n    JOIN retail_sales.products AS p ON p.product_id = oi.product_id\n    WHERE o.ordered_at >= TIMESTAMP '2026-07-01'\n      AND o.ordered_at < TIMESTAMP '2026-10-01'\n    GROUP BY p.category\n  ),\n  -- Return value per category in Q3 2026\n  returns_q3 AS (\n    SELECT\n      p.category,\n      SUM(r.returned_amount) AS returned_value\n    FROM retail_sales.returns AS r\n    JOIN retail_sales.order_items AS oi ON oi.order_item_id = r.order_item_id\n    JOIN retail_sales.products AS p ON p.product_id = oi.product_id\n    WHERE r.returned_at >= TIMESTAMP '2026-07-01'\n      AND r.returned_at < TIMESTAMP '2026-10-01'\n    GROUP BY p.category\n  )\nSELECT\n  s.category,\n  s.net_sales,\n  COALESCE(r.returned_value, 0) AS returned_value,\n  ROUND(COALESCE(r.returned_value, 0) / NULLIF(s.net_sales, 0), 4) AS return_rate\nFROM sales_q3 AS s\nLEFT JOIN returns_q3 AS r USING (category)\nORDER BY return_rate DESC",

            "sql": "WITH q3_2026_targets AS (\n  SELECT category, target_net_sales\n  FROM retail_sales.merchandising_plan_category_targets\n  WHERE quarter = '2026-Q3'\n),\nq3_2026_actuals AS (\n  SELECT p.category, SUM(oi.line_amount) AS actual_net_sales\n  FROM retail_sales.order_items oi\n  JOIN retail_sales.orders o ON oi.order_id = o.order_id\n  JOIN retail_sales.products p ON oi.product_id = p.product_id\n  WHERE o.ordered_at >= '2026-07-01' AND o.ordered_at < '2026-10-01'\n  GROUP BY p.category\n)\nSELECT \n  t.category,\n  t.target_net_sales,\n  COALESCE(a.actual_net_sales, 0) AS actual_net_sales,\n  t.target_net_sales - COALESCE(a.actual_net_sales, 0) AS shortfall_usd,\n  ROUND(100.0 * (t.target_net_sales - COALESCE(a.actual_net_sales, 0)) / t.target_net_sales, 2) AS pct_missed\nFROM q3_2026_targets t\nLEFT JOIN q3_2026_actuals a ON t.category = a.category\nWHERE COALESCE(a.actual_net_sales, 0) < t.target_net_sales\nORDER BY pct_missed DESC;",

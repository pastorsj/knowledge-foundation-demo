                    "text"
                  ]
                }
              },
              {
                "rank": 5,
                "score": 0.3321145176887512,
                "vectorScore": 0.3321145176887512,
                "sourceId": "retail.policies",
                "documentId": "retail.policies:f-5f41a46b802af34a",
                "chunkId": "retail.policies:f-5f41a46b802af34a:0003",
                "title": "return-refund-policy.pdf",
                "url": null,
                "publishedAt": null,
                "snippet": "Return and Refund Policy\n1. Purpose and scope\nThis policy sets out how Lumen Retail Group (\"Lumen\") accepts returns and issues refunds at its 24 stores and on Lumen.com. It applies to every colleague who processes a return, answers a customer question about one, or approves an exception. It replaces version 4.1 (March 1, 2025) in full.\nThe policy balances two goals: customers should be able to return a purchase easily, and the cost of returns that could have been avoided (opened electronics, bulky furniture, abused promotions) should not fall on everyone else. The restocking fees in section 2 are how that balance is set. Asset Protection issues separate memos on fraud controls; those memos supplement this policy and win where they are stricter.",
                "metadata": {
                  "parser": "nemotron-parse-2.0",
                  "file_id": "f-5f41a46b802af34a",
                  "file_name": "return-refund-policy.pdf",
                  "citation": "return-refund-policy.pdf, p. 1",
                  "page_start": 1,
                  "page_end": 1,
                  "headings": "Return and Refund Policy › 1. Purpose and scope",
                  "labels": [
                    "text"
                  ]
                }
              },
              {
                "rank": 6,
                "score": 0.32287517189979553,
                "vectorScore": 0.32287517189979553,

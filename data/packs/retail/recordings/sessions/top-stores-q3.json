          "content": {
            "query": "Five physical stores with highest net sales in Q3 2026",
            "databaseName": "retail_sales",
            "answer": null,
            "sql": "SELECT \n    s.store_id,\n    s.store_name,\n    s.region,\n    s.store_type,\n    ROUND(SUM(o.net_amount), 2) AS net_sales_usd\nFROM retail_sales.orders AS o\nJOIN retail_sales.stores AS s USING (store_id)\nWHERE o.ordered_at >= TIMESTAMP '2026-07-01' \n  AND o.ordered_at < TIMESTAMP '2026-10-01'\n  AND s.store_id != 'WEB'\nGROUP BY s.store_id, s.store_name, s.region, s.store_type\nORDER BY net_sales_usd DESC\nLIMIT 5",

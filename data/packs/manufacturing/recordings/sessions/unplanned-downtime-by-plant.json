          "content": {
            "query": "Unplanned downtime hours and event count by plant in Q3 2026 (July 1 to September 30, 2026)",
            "databaseName": "manufacturing_operations",
            "answer": null,
            "sql": "SELECT \n    m.plant_id,\n    p.plant_name,\n    COUNT(*) AS unplanned_events,\n    ROUND(SUM(me.downtime_hours), 1) AS total_unplanned_downtime_hours\nFROM manufacturing_operations.maintenance_events AS me\nJOIN manufacturing_operations.machines AS m USING (machine_id)\nJOIN manufacturing_operations.plants AS p USING (plant_id)\nWHERE me.event_type = 'unplanned'\n  AND me.started_at >= TIMESTAMP '2026-07-01'\n  AND me.started_at < TIMESTAMP '2026-10-01'\nGROUP BY m.plant_id, p.plant_name\nORDER BY total_unplanned_downtime_hours DESC",
            "rows": [
              {

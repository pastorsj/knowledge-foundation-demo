            "query": "Count unplanned maintenance events, downtime hours, and quality defect costs for machine MTY-LTH-04 since 1 July 2026",
            "databaseName": "manufacturing_operations",
            "answer": null,
            "sql": "WITH unplanned_events AS (\n  SELECT\n    COUNT(*) AS unplanned_event_count,\n    SUM(downtime_hours) AS total_unplanned_downtime_hours,\n    SUM(parts_and_labor_cost_usd) AS total_unplanned_cost_usd\n  FROM manufacturing_operations.maintenance_events\n  WHERE machine_id = 'MTY-LTH-04'\n    AND event_type = 'unplanned'\n    AND started_at >= '2026-07-01'\n),\ndefect_costs AS (\n  SELECT\n    SUM(cost_usd) AS total_defect_cost_usd\n  FROM manufacturing_operations.quality_defects\n  WHERE machine_id = 'MTY-LTH-04'\n    AND detected_at >= '2026-07-01'\n)\nSELECT\n  ue.unplanned_event_count,\n  ue.total_unplanned_downtime_hours,\n  ue.total_unplanned_cost_usd,\n  dc.total_defect_cost_usd\nFROM unplanned_events ue\nCROSS JOIN defect_costs dc;",

            "databaseName": "manufacturing_operations",
            "answer": null,
            "sql": "SELECT machine_id, plant_id, machine_type\nFROM manufacturing_operations.machines\nWHERE machine_id IN ('DAY-LTH-05', 'DAY-PRS-04', 'BRN-LTH-04', 'BRN-LTH-03', 'DAY-MIL-02')\nORDER BY \n  CASE machine_id \n    WHEN 'DAY-LTH-05' THEN 1\n    WHEN 'DAY-PRS-04' THEN 2\n    WHEN 'BRN-LTH-04' THEN 3\n    WHEN 'BRN-LTH-03' THEN 4\n    WHEN 'DAY-MIL-02' THEN 5\n  END",

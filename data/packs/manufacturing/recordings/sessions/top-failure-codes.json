          "content": {
            "query": "Three failure codes with most unplanned downtime hours between 2025-10-01 and 2026-09-30",
            "databaseName": "manufacturing_operations",
            "answer": null,
            "sql": "SELECT\n    failure_code,\n    ROUND(SUM(downtime_hours), 2) AS total_downtime_hours\nFROM manufacturing_operations.maintenance_events\nWHERE event_type = 'unplanned'\n  AND failure_code IS NOT NULL\n  AND failure_code != ''\n  AND started_at >= TIMESTAMP '2025-10-01'\n  AND started_at < TIMESTAMP '2026-10-01'\nGROUP BY failure_code\nORDER BY total_downtime_hours DESC\nLIMIT 3",

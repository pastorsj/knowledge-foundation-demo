            "databaseName": "manufacturing_operations",
            "answer": null,
            "sql": "SELECT \n    plant_id,\n    SUM(target_units) AS total_target_units,\n    SUM(actual_units) AS total_actual_units,\n    ROUND(SUM(actual_units) / NULLIF(SUM(target_units), 0) * 100, 2) AS attainment_pct\nFROM manufacturing_operations.production_plan_weekly_output\nWHERE week_start >= DATE '2026-07-06' AND week_start <= DATE '2026-09-21'\nGROUP BY plant_id\nORDER BY attainment_pct ASC",

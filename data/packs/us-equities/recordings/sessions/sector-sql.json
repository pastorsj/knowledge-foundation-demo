          "content": {
            "query": "For each SIC division, count every stock and give the median of its stocks' returns from 2026-01-02 to 2026-03-12. Measure each stock's return from its close on its latest trading day before 2026-01-02 (or its first close in the window, if it was listed later) to its close on its latest trading day in the window; a stock without a close in the window has no return. Sort divisions by stock count, highest first.",
            "databaseName": "us_equities",
            "answer": "This query counts all stocks in each SIC division (sector) and calculates the median return for those stocks that have a price both before and within the specified window. It fetches each stock's latest closing price in the window and its appropriate starting price (latest before the window, or first inside if none) using correlated subqueries, computes the return as (end_price/start_price)-1, excludes missing returns from the median via a CASE expression, and finally groups by sector, ordering the results by stock count from highest to lowest.",
            "sql": "WITH returns AS ( SELECT a.asset_id, a.sector, ( SELECT dp.adjusted_close FROM us_equities.main.daily_prices dp WHERE dp.asset_id = a.asset_id AND dp.trading_date BETWEEN DATE '2026-01-02' AND DATE '2026-03-12' ORDER BY dp.trading_date DESC LIMIT 1 ) AS end_price, COALESCE( ( SELECT dp.adjusted_close FROM us_equities.main.daily_prices dp WHERE dp.asset_id = a.asset_id AND dp.trading_date < DATE '2026-01-02' ORDER BY dp.trading_date DESC LIMIT 1 ), ( SELECT dp.adjusted_close FROM us_equities.main.daily_prices dp WHERE dp.asset_id = a.asset_id AND dp.trading_date BETWEEN DATE '2026-01-02' AND DATE '2026-03-12' ORDER BY dp.trading_date ASC LIMIT 1 ) ) AS start_price FROM us_equities.main.assets a ) SELECT r.sector, COUNT(r.asset_id) AS stock_count, percentile_cont(0.5) WITHIN GROUP (ORDER BY CASE WHEN r.end_price IS NOT NULL AND r.start_price IS NOT NULL THEN (r.end_price / r.start_price) - 1 END) AS median_return FROM returns r GROUP BY r.sector ORDER BY stock_count DESC;",

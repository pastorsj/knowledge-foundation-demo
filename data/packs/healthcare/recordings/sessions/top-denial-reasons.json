          "content": {
            "query": "Top three denial reasons by billed dollars for claims denied in 2026, with share of total",
            "databaseName": "healthcare_clinical",
            "answer": null,
            "sql": "WITH denied_2026 AS (\n    SELECT\n        denial_reason,\n        SUM(billed_amount) AS total_billed\n    FROM healthcare_clinical.claims\n    WHERE denied = 1\n      AND adjudicated_date IS NOT NULL\n      AND YEAR(adjudicated_date) = 2026\n      AND denial_reason IS NOT NULL\n    GROUP BY denial_reason\n),\ntotal_denied AS (\n    SELECT SUM(total_billed) AS grand_total FROM denied_2026\n)\nSELECT\n    d.denial_reason,\n    ROUND(d.total_billed, 2) AS billed_dollars,\n    ROUND(100.0 * d.total_billed / t.grand_total, 2) AS share_pct\nFROM denied_2026 d\nCROSS JOIN total_denied t\nORDER BY d.total_billed DESC\nLIMIT 3",
            "rows": [
              {

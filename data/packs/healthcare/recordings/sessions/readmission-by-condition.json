        {
          "schemaVersion": "2",
          "artifactKind": "structured_query",
          "receiptId": "hermes-receipt:a55cae598449e066ade7fab3b62b4e821d2d245bbd4374fe5d9a35d5fc81691a",
          "jobId": "3efc6a72-843f-442c-968f-576945fa747a",
          "invocationId": "hermes-tool:chatcmpl-tool-87870f66f9ad4dd88570a0b56799b627",
          "turnId": "3efc6a72-843f-442c-968f-576945fa747a:3efc6a72-843f-442c-968f-576945fa747a:a06752aa",
          "toolName": "mcp__tables__query_tables",
          "status": "completed",
          "errorType": null,
          "errorSummary": null,
          "durationMs": 314,
          "traceId": null,
          "spanId": null,
          "occurredAt": "2026-10-04T05:33:06.998306Z",
          "content": {
            "query": "Compare 30-day readmission rates for heart failure, COPD, and other inpatient discharges from April 2025 through August 2026, excluding deaths and hospice",
            "databaseName": "healthcare_clinical",
            "answer": null,
            "sql": "WITH index_discharges AS (\n    SELECT\n        e.encounter_id,\n        e.patient_id,\n        e.facility_id,\n        e.admit_ts,\n        e.discharge_ts,\n        e.discharge_disposition,\n        d.icd10_code,\n        d.icd10_description,\n        d.is_primary,\n        CASE\n            WHEN d.icd10_code LIKE 'I50%' AND d.is_primary = 1 THEN 'Heart Failure'\n            WHEN d.icd10_code LIKE 'J44%' AND d.is_primary = 1 THEN 'COPD'\n            ELSE 'Other'\n        END AS cohort\n    FROM healthcare_clinical.encounters e\n    JOIN healthcare_clinical.diagnoses d ON e.encounter_id = d.encounter_id\n    WHERE e.encounter_type = 'inpatient'\n      AND e.discharge_ts >= '2025-04-01'\n      AND e.discharge_ts < '2026-09-01'\n      AND e.discharge_disposition NOT IN ('expired', 'hospice')\n      AND d.is_primary = 1\n),\nreadmissions AS (\n    SELECT\n        i.encounter_id AS index_encounter_id,\n        i.patient_id,\n        i.cohort,\n        i.discharge_ts AS index_discharge_ts,\n        MIN(e2.admit_ts) AS readmit_admit_ts\n    FROM index_discharges i\n    LEFT JOIN healthcare_clinical.encounters e2\n        ON i.patient_id = e2.patient_id\n        AND e2.encounter_type = 'inpatient'\n        AND e2.admit_ts > i.discharge_ts\n        AND e2.admit_ts <= i.discharge_ts + INTERVAL '30 days'\n    GROUP BY i.encounter_id, i.patient_id, i.cohort, i.discharge_ts\n)\nSELECT\n    cohort,\n    COUNT(*) AS index_discharges,\n    SUM(CASE WHEN readmit_admit_ts IS NOT NULL THEN 1 ELSE 0 END) AS readmissions_30d,\n    ROUND(100.0 * SUM(CASE WHEN readmit_admit_ts IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 2) AS readmission_rate_pct\nFROM readmissions\nGROUP BY cohort\nORDER BY\n    CASE cohort WHEN 'Heart Failure' THEN 1 WHEN 'COPD' THEN 2 ELSE 3 END;",
            "rows": [
              {
                "cohort": "Heart Failure",
                "index_discharges": 191,
                "readmissions_30d": 40,
                "readmission_rate_pct": 20.94
              },
              {
                "cohort": "COPD",
                "index_discharges": 71,
                "readmissions_30d": 17,
                "readmission_rate_pct": 23.94
              },
              {
                "cohort": "Other",
                "index_discharges": 462,
                "readmissions_30d": 49,
                "readmission_rate_pct": 10.61
              }
            ],
            "sourceRowCount": 3,

          "content": {
            "query": "Quarterly 30-day readmission rate at each hospital for Q2 2026, aggregated from monthly data",
            "databaseName": "healthcare_clinical",
            "answer": null,
            "sql": "WITH hospitals AS (\n  SELECT facility_id, facility_name\n  FROM healthcare_clinical.facilities\n  WHERE facility_type = 'hospital'\n)\nSELECT\n  r.facility_id,\n  h.facility_name,\n  SUM(r.index_discharges) AS total_index_discharges,\n  SUM(r.readmissions_30d) AS total_readmissions,\n  ROUND(SUM(r.readmissions_30d) / SUM(r.index_discharges) * 100, 1) AS quarterly_readmission_rate_pct\nFROM healthcare_clinical.quality_scorecard_readmissions r\nJOIN hospitals h ON r.facility_id = h.facility_id\nWHERE r.month >= '2026-04-01' AND r.month <= '2026-06-30'\n  AND r.cohort = 'All-cause'\nGROUP BY r.facility_id, h.facility_name\nORDER BY r.facility_id;",
            "rows": [
              {
                "facility_id": "F01",

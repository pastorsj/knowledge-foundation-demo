          "content": {
            "query": "Count and billed amount of denied claims not yet appealed that are still within their payer's first-level appeal window as of 2026-09-30",
            "databaseName": "healthcare_clinical",
            "answer": null,
            "sql": "WITH appeal_windows AS (\n  SELECT 'Medicare' AS payer, 120 AS window_days\n  UNION ALL SELECT 'Northstar Advantage', 60\n  UNION ALL SELECT 'Medicaid', 90\n  UNION ALL SELECT 'Evergreen Health Plan', 180\n  UNION ALL SELECT 'Cascade Mutual', 60\n  -- Self-pay has no appeal window\n),\ndenied_claims AS (\n  SELECT\n    c.claim_id,\n    c.payer,\n    c.adjudicated_date,\n    c.billed_amount,\n    c.appeal_status,\n    aw.window_days\n  FROM healthcare_clinical.claims c\n  JOIN appeal_windows aw ON c.payer = aw.payer\n  WHERE c.denied = 1\n    AND c.appeal_status = 'none'\n    AND c.adjudicated_date IS NOT NULL\n)\nSELECT\n  dc.payer,\n  COUNT(*) AS denied_not_appealed_count,\n  SUM(dc.billed_amount) AS total_billed_amount_usd\nFROM denied_claims dc\nWHERE dc.adjudicated_date + INTERVAL (dc.window_days) DAY >= DATE '2026-09-30'\nGROUP BY dc.payer\nORDER BY dc.payer;",
            "rows": [

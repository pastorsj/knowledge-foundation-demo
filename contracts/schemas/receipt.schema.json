{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EntityPrediction": {
      "additionalProperties": false,
      "description": "One entity's predicted outcome: `probability` for a binary task (or the score of a multiclass `label`),\n`value` for a regression.",
      "properties": {
        "entityId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "entityId",
        "probability",
        "value",
        "label"
      ],
      "title": "EntityPrediction",
      "type": "object"
    },
    "JsonValue": {},
    "LineageBinding": {
      "additionalProperties": false,
      "description": "How Auto Ontology bound one phrase of the question to a column.",
      "properties": {
        "phrase": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "ontologyObject": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "table": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "column": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "phrase",
        "ontologyObject",
        "table",
        "column"
      ],
      "title": "LineageBinding",
      "type": "object"
    },
    "PredictionHorizon": {
      "additionalProperties": false,
      "description": "How far past the anchor time the outcome is counted, read from the PQL window.",
      "properties": {
        "value": {
          "type": "integer"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "PredictionHorizon",
      "type": "object"
    },
    "RetrievalEvidence": {
      "additionalProperties": false,
      "description": "A `retrieve_evidence` result: per-source vector search, one merged rerank (when a rerank model is\nconfigured), the best hits.\n\n`collection` is the alias the tool searched; the collection version is the index build behind it.",
      "properties": {
        "query": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "sourceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "collection": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,254}$",
          "type": "string"
        },
        "collectionVersion": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,254}$",
          "type": "string"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/RetrievalHit"
          },
          "maxItems": 25,
          "type": "array"
        },
        "candidateCounts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "models": {
          "$ref": "#/$defs/RetrievalModels"
        },
        "index": {
          "$ref": "#/$defs/RetrievalIndex"
        },
        "timings": {
          "$ref": "#/$defs/RetrievalTimings"
        }
      },
      "required": [
        "query",
        "sourceIds",
        "collection",
        "collectionVersion",
        "hits",
        "candidateCounts",
        "models",
        "index",
        "timings"
      ],
      "title": "RetrievalEvidence",
      "type": "object"
    },
    "RetrievalEvidenceReceipt": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2",
          "default": "2",
          "type": "string"
        },
        "artifactKind": {
          "const": "retrieval_evidence",
          "type": "string"
        },
        "receiptId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "jobId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "turnId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toolName": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "type": "string"
        },
        "errorType": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errorSummary": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "durationMs": {
          "maximum": 86400000,
          "minimum": 0,
          "type": "integer"
        },
        "traceId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spanId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurredAt": {
          "format": "date-time",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schemaVersion",
        "artifactKind",
        "receiptId",
        "jobId",
        "invocationId",
        "turnId",
        "toolName",
        "status",
        "errorType",
        "errorSummary",
        "durationMs",
        "traceId",
        "spanId",
        "occurredAt",
        "content"
      ],
      "title": "RetrievalEvidenceReceipt",
      "type": "object"
    },
    "RetrievalHit": {
      "additionalProperties": false,
      "description": "One passage from `retrieve_evidence`, ordered by `score`: its rerank logit, or its vector score (cosine)\nwhen the retrieval ran without a rerank model.",
      "properties": {
        "rank": {
          "minimum": 1,
          "type": "integer"
        },
        "score": {
          "type": "number"
        },
        "vectorScore": {
          "type": "number"
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "documentId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "chunkId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "publishedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snippet": {
          "maxLength": 1500,
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      },
      "required": [
        "rank",
        "score",
        "vectorScore",
        "sourceId",
        "documentId",
        "chunkId",
        "title",
        "url",
        "publishedAt",
        "snippet",
        "metadata"
      ],
      "title": "RetrievalHit",
      "type": "object"
    },
    "RetrievalIndex": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "metric": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "searchParams": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "type",
        "metric",
        "params",
        "searchParams"
      ],
      "title": "RetrievalIndex",
      "type": "object"
    },
    "RetrievalModels": {
      "additionalProperties": false,
      "description": "The models behind a retrieval; `rerank` is null when none is configured and the hits keep vector order.",
      "properties": {
        "embed": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "rerank": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "embed",
        "rerank"
      ],
      "title": "RetrievalModels",
      "type": "object"
    },
    "RetrievalTimings": {
      "additionalProperties": false,
      "description": "Wall-clock stages of one retrieval, in milliseconds; `rerank_ms` is 0 when it ran without a rerank model.",
      "properties": {
        "embedMs": {
          "minimum": 0,
          "type": "number"
        },
        "searchMs": {
          "minimum": 0,
          "type": "number"
        },
        "rerankMs": {
          "minimum": 0,
          "type": "number"
        },
        "totalMs": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "embedMs",
        "searchMs",
        "rerankMs",
        "totalMs"
      ],
      "title": "RetrievalTimings",
      "type": "object"
    },
    "StructuredPrediction": {
      "additionalProperties": false,
      "description": "A PQL query scored per entity by NVIDIA Kumo (`predict`) over one structured source.\n\n`template_id` names the source's prediction template when the PQL came from one. `task_type` is the task Kumo\nran (binary, regression, multiclass), `anchor_time` the time predictions are made from, `horizon` the PQL\nwindow, and `entity_table` the table of the `FOR EACH` entities, when known. `available` is false, with a\n`reason`, when the prediction could not run.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "templateId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pql": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        "taskType": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anchorTime": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "horizon": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionHorizon"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entityTable": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityPrediction"
          },
          "maxItems": 100,
          "type": "array"
        },
        "model": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "available",
        "reason",
        "sourceId",
        "templateId",
        "pql",
        "taskType",
        "anchorTime",
        "horizon",
        "entityTable",
        "rows",
        "model"
      ],
      "title": "StructuredPrediction",
      "type": "object"
    },
    "StructuredPredictionReceipt": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2",
          "default": "2",
          "type": "string"
        },
        "artifactKind": {
          "const": "structured_prediction",
          "type": "string"
        },
        "receiptId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "jobId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "turnId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toolName": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "type": "string"
        },
        "errorType": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errorSummary": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "durationMs": {
          "maximum": 86400000,
          "minimum": 0,
          "type": "integer"
        },
        "traceId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spanId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurredAt": {
          "format": "date-time",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredPrediction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schemaVersion",
        "artifactKind",
        "receiptId",
        "jobId",
        "invocationId",
        "turnId",
        "toolName",
        "status",
        "errorType",
        "errorSummary",
        "durationMs",
        "traceId",
        "spanId",
        "occurredAt",
        "content"
      ],
      "title": "StructuredPredictionReceipt",
      "type": "object"
    },
    "StructuredQuery": {
      "additionalProperties": false,
      "description": "A SQL result over structured sources: `query_tables` (DuckDB) or Auto Ontology `ask_question`.\n\n`query` is the question the SQL answers, and `database_name` the database it ran on: the DuckDB alias of the\none structured source `query_tables` attached (`knowledge` when it attached several), or Auto Ontology's\ndatabase. `answer` and `resolution_lineage` come from Auto Ontology only. `sql` is null when Auto Ontology\nresolved the question's terms but could not construct a query.",
      "properties": {
        "query": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "databaseName": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sql": {
          "anyOf": [
            {
              "maxLength": 12000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rows": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxItems": 25,
          "type": "array"
        },
        "sourceRowCount": {
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "resolutionLineage": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LineageBinding"
          },
          "maxItems": 40,
          "type": "array"
        }
      },
      "required": [
        "query",
        "databaseName",
        "answer",
        "sql",
        "rows",
        "sourceRowCount",
        "truncated",
        "resolutionLineage"
      ],
      "title": "StructuredQuery",
      "type": "object"
    },
    "StructuredQueryReceipt": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2",
          "default": "2",
          "type": "string"
        },
        "artifactKind": {
          "const": "structured_query",
          "type": "string"
        },
        "receiptId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "jobId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "type": "string"
        },
        "turnId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toolName": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "type": "string"
        },
        "errorType": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errorSummary": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "durationMs": {
          "maximum": 86400000,
          "minimum": 0,
          "type": "integer"
        },
        "traceId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spanId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurredAt": {
          "format": "date-time",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schemaVersion",
        "artifactKind",
        "receiptId",
        "jobId",
        "invocationId",
        "turnId",
        "toolName",
        "status",
        "errorType",
        "errorSummary",
        "durationMs",
        "traceId",
        "spanId",
        "occurredAt",
        "content"
      ],
      "title": "StructuredQueryReceipt",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "retrieval_evidence": "#/$defs/RetrievalEvidenceReceipt",
      "structured_prediction": "#/$defs/StructuredPredictionReceipt",

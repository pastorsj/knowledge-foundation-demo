{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolRegistry",
  "description": "Every MCP tool Hermes may call, with its identity, receipt kind and UI hints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tools"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Tool"
      }
    }
  },
  "$defs": {
    "Tool": {
      "title": "Tool",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "server",
        "hermes_name",
        "family",
        "label",
        "description",
        "explorer",
        "receipt_kind",
        "profile",
        "pills"
      ],
      "properties": {
        "id": {
          "description": "The MCP tool name.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "server": {
          "description": "The Hermes MCP server key.",
          "enum": [
            "retrieval",
            "tables",
            "prediction",
            "auto_ontology"
          ]
        },
        "hermes_name": {
          "description": "The name Hermes uses for the tool: mcp__<server>__<id>.",
          "type": "string",
          "pattern": "^mcp__[a-z][a-z0-9_]*__[a-z][a-z0-9_]*$"
        },
        "family": {
          "description": "The capability family a data source must grant for the tool to run.",
          "enum": [
            "unstructured_retrieval",
            "structured_retrieval",
            "structured_prediction"
          ]
        },
        "label": {
          "description": "Short display name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "description": "One line for the UI saying what the tool does.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "explorer": {
          "description": "The UI explorer that renders the tool's receipts.",
          "enum": [
            "retrieval",
            "sql",
            "pql",
            "ontology"
          ]
        },
        "receipt_kind": {
          "description": "The artifactKind of the tool's receipts.",
          "enum": [
            "retrieval_evidence",
            "structured_query",
            "structured_prediction"
          ]
        },
        "profile": {
          "description": "The agent feature that ships the tool: retrieval and tables run in the core profile, kumo with the kumo or prediction profile, ontology with the ontology profile.",
          "enum": [
            "retrieval",
            "tables",
            "kumo",
            "ontology"
          ]
        },
        "pills": {
          "description": "The technology pills the UI shows for a question or a recorded run that uses the tool.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Pill"
          }
        }
      }
    },
    "Pill": {
      "title": "Pill",
      "description": "A technology pill, in display order: retrieval (Nemotron embed and rerank over Milvus), duckdb (SQL over DuckDB), kumo (NVIDIA Kumo), ontology (Auto Ontology); questions.yaml `tools` names these too.",
      "enum": [
        "retrieval",
        "duckdb",
        "kumo",
        "ontology"
      ]
    }
  }
}

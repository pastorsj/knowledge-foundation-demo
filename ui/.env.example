# UI runtime configuration (read at request time; no rebuild needed).
# In Compose these are set by compose.yaml; for `npm run dev` copy this file
# to .env.local and adjust.

# live: questions go to the API. replay: only recorded sessions, no API calls.
UI_MODE=live

# Demo API (server-side only; the browser calls the same-origin /api/v1 proxy).
API_URL=http://127.0.0.1:8300

# The data packs; each pack's replay bundle is $PACKS_DIR/<pack>/recordings
PACKS_DIR=../data/packs
# The pack shown until the user picks another (the industry selector remembers the choice)
DEFAULT_PACK=retail

# Browser-reachable Phoenix UI. Leave unset to hide the Phoenix link.
PHOENIX_URL=http://127.0.0.1:6306

# The composer's microphone (live mode only). The API transcribes the recording with NVIDIA
# Nemotron ASR; it needs SPEECH_INPUT_ENABLED and a key on its side too (api/README.md).
SPEECH_INPUT_ENABLED=false
SPEECH_INPUT_MAX_SECONDS=60

# Your data's uploads (live mode). The defaults match the ingest service's limits
# (INGEST_MAX_FILE_MB, INGEST_MAX_FILES).
# FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.webp,.docx,.pptx,.html,.md,.txt,.csv,.tsv,.xlsx,.parquet,.json,.jsonl
# FILE_UPLOAD_MAX_SIZE_MB=100
# FILE_UPLOAD_MAX_FILE_COUNT=20
# The largest upload request the /api/v1 proxy forwards; past it, a 413
# FILE_UPLOAD_MAX_REQUEST_MB=512

                "cash_currency": "USD",
                "company_name": "Aether Compute",
                "completeness_status": "complete for available observed records through 2026-09-28 05:16:38 UTC; not truncated",
                "effective_session_date": "2026-05-15T00:00:00.000",
                "price_return_1d": -0.015080746,
                "row_count": 2,
                "ticker": "AETH",
                "total_minus_price_return_percentage_points": 0.0930435958,
                "total_return_1d": -0.01415031
              }
            ],
            "sourceRowCount": 2,
            "truncated": false,
            "resolutionLineage": [
              {
                "phrase": "corporate-action cash amount",

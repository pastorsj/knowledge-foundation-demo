      "queries": [
        {
          "sql": "SELECT c.tier, count(*) AS orders, round(sum(o.net_amount), 2) AS net_revenue\nFROM retail_sales.orders AS o\nJOIN retail_sales.customers AS c USING (customer_id)\nWHERE o.ordered_at >= TIMESTAMP '2026-07-01' AND o.ordered_at < TIMESTAMP '2026-10-01'\nGROUP BY c.tier\nORDER BY net_revenue DESC",
          "result": {
            "columns": [
              "tier",
              "orders",
              "net_revenue"
            ],

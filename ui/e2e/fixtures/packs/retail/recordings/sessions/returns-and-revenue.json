      "receipts": [
        {
          "schemaVersion": "2",
          "artifactKind": "structured_query",
          "receiptId": "hermes-receipt:ca45eef2f9b69e18546819c8492e8df1dec888ba511f47e35bacee7d2384bd52",
          "jobId": "2e1e9c6d-8c4a-4d2f-9716-1cb1e6659c78",
          "invocationId": "hermes-tool:call_QhOAsXb68luYCFIAF1hWJ7z2",
          "turnId": null,
          "toolName": "mcp__tables__query_tables",
          "status": "completed",
          "errorType": null,
          "errorSummary": null,
          "durationMs": 173,
          "traceId": "01a0e6627c447b83a27dc6ec13c18349",
          "spanId": "bcf375c672770770",
          "occurredAt": "2026-09-28T05:00:21.762077Z",
          "content": {
            "query": "Which loyalty tier brought the most net revenue in the third quarter of 2026?",
            "databaseName": "retail_sales",
            "answer": null,
            "sql": "SELECT c.tier, count(*) AS orders, round(sum(o.net_amount), 2) AS net_revenue\nFROM retail_sales.orders AS o\nJOIN retail_sales.customers AS c USING (customer_id)\nWHERE o.ordered_at >= TIMESTAMP '2026-07-01' AND o.ordered_at < TIMESTAMP '2026-10-01'\nGROUP BY c.tier\nORDER BY net_revenue DESC",
            "rows": [
              {
                "tier": "gold",
                "orders": 3,
                "net_revenue": 395.0
              },
              {

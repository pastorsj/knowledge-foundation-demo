          "content": {
            "query": "How many orders did gold-tier customers place, and what was their average order value?",
            "databaseName": "retail_sales",
            "answer": "Gold-tier customers placed 4 orders with an average net order value of $128.88.",
            "sql": "SELECT count(*) AS order_count, round(avg(o.net_amount), 2) AS average_order_value\nFROM orders AS o\nJOIN customers AS c ON c.customer_id = o.customer_id\nWHERE c.tier = 'gold'",
            "rows": [
              {
                "order_count": 4,
                "average_order_value": 128.88
              }
            ],

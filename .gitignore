# Secrets and local configuration
.env
.env.*
!.env.example

# Scratch build contexts (tools/auto-ontology/prepare.sh)
.build/

# scripts/demo.sh lifecycle state
.demo/

# demo.sh eval run directories: a deployment's answers and evidence
/eval/runs/

# Packs commit their tables as CSV and XLSX; database and columnar files are built by ingest.
# Parquet is allowed only in test fixtures; the pre-commit hook enforces the same rule.
*.duckdb
*.duckdb.wal
*.parquet
*.arrow
*.feather
!**/tests/fixtures/**/*.parquet

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/

# Node and Next.js
node_modules/
.next/
*.tsbuildinfo
test-results/
playwright-report/

# OS
.DS_Store
.claude/
.superpowers/
